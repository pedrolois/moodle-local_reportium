{{!
    @template local_reportium/admin_states

    State codes of "state" columns in the plugin settings: one row per state, with Add and Remove.

    Context variables required for this template:
    * name - form field name
    * id - element id
    * rows - [{code, color, aliases, label, preview, textcolor}]
    * empty - the same fields for a new row

    Example context (json):
    {
        "name": "s_local_reportium_states", "id": "id_s_local_reportium_states",
        "rows": [{"code": "completed", "color": "#73a839", "aliases": "done, completado", "label": "",
            "preview": "Completed", "textcolor": "#ffffff"}],
        "empty": {"code": "", "color": "#6c757d", "aliases": "", "label": "", "preview": "", "textcolor": "#ffffff"}
    }
}}
<div class="reportium-admin-states" id="{{id}}" data-region="admin-states">
    <input type="hidden" name="{{name}}[present]" value="1">
    <table class="table table-sm reportium-admin-states-table">
        <thead>
            <tr>
                <th scope="col">{{#str}} settings_states_code, local_reportium {{/str}}</th>
                <th scope="col">{{#str}} settings_states_color, local_reportium {{/str}}</th>
                <th scope="col">{{#str}} settings_states_aliases, local_reportium {{/str}}</th>
                <th scope="col">{{#str}} settings_states_label, local_reportium {{/str}}</th>
                <th scope="col">{{#str}} settings_states_preview, local_reportium {{/str}}</th>
                <th scope="col"><span class="sr-only visually-hidden">{{#str}} delete {{/str}}</span></th>
            </tr>
        </thead>
        <tbody data-region="rows">
            {{#rows}}
            <tr data-region="state-row">
                <td><input type="text" class="form-control form-control-sm" name="{{name}}[code][]" value="{{code}}" size="14"
                    aria-label="{{#str}} settings_states_code, local_reportium {{/str}}"></td>
                <td><input type="color" class="form-control form-control-sm reportium-admin-color" name="{{name}}[color][]"
                    value="{{color}}" aria-label="{{#str}} settings_states_color, local_reportium {{/str}}"></td>
                <td><input type="text" class="form-control form-control-sm" name="{{name}}[aliases][]" value="{{aliases}}"
                    aria-label="{{#str}} settings_states_aliases, local_reportium {{/str}}"></td>
                <td><input type="text" class="form-control form-control-sm" name="{{name}}[label][]" value="{{label}}" size="14"
                    aria-label="{{#str}} settings_states_label, local_reportium {{/str}}"></td>
                <td><span class="reportium-state" data-region="preview"
                    style="background-color: {{color}}; color: {{textcolor}}">{{preview}}</span></td>
                <td><button type="button" class="btn btn-link btn-sm text-danger" data-action="remove-state"
                    title="{{#str}} delete {{/str}}"><i class="fa fa-trash" aria-hidden="true"></i>
                    <span class="sr-only visually-hidden">{{#str}} delete {{/str}}</span></button></td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    <template data-region="row-template">
        {{#empty}}
        <tr data-region="state-row">
            <td><input type="text" class="form-control form-control-sm" name="{{name}}[code][]" value="{{code}}" size="14"
                aria-label="{{#str}} settings_states_code, local_reportium {{/str}}"></td>
            <td><input type="color" class="form-control form-control-sm reportium-admin-color" name="{{name}}[color][]"
                value="{{color}}" aria-label="{{#str}} settings_states_color, local_reportium {{/str}}"></td>
            <td><input type="text" class="form-control form-control-sm" name="{{name}}[aliases][]" value="{{aliases}}"
                aria-label="{{#str}} settings_states_aliases, local_reportium {{/str}}"></td>
            <td><input type="text" class="form-control form-control-sm" name="{{name}}[label][]" value="{{label}}" size="14"
                aria-label="{{#str}} settings_states_label, local_reportium {{/str}}"></td>
            <td><span class="reportium-state" data-region="preview"
                style="background-color: {{color}}; color: {{textcolor}}">{{preview}}</span></td>
            <td><button type="button" class="btn btn-link btn-sm text-danger" data-action="remove-state"
                title="{{#str}} delete {{/str}}"><i class="fa fa-trash" aria-hidden="true"></i>
                <span class="sr-only visually-hidden">{{#str}} delete {{/str}}</span></button></td>
        </tr>
        {{/empty}}
    </template>
    <button type="button" class="btn btn-secondary btn-sm" data-action="add-state">
        <i class="fa fa-plus" aria-hidden="true"></i> {{#str}} settings_states_add, local_reportium {{/str}}
    </button>
</div>
