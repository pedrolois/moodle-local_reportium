{{!
    @template local_reportium/navigation

    Navigation of a report for its editors: one pill per section, "All reports" on the right.

    Context variables required for this template:
    * items - [{url, label, icon, active}]
    * allreports - {url, label, active}

    Example context (json):
    {
        "items": [
            {"url": "#", "label": "Report", "icon": "fa-bar-chart", "active": true},
            {"url": "#", "label": "Settings", "icon": "fa-cog", "active": false}
        ],
        "allreports": {"url": "#", "label": "All reports", "active": false}
    }
}}
<nav class="reportium-nav d-print-none" aria-label="{{#str}}pluginname, local_reportium{{/str}}" data-region="reportium-nav">
    <ul class="reportium-nav-list">
        {{#items}}
        <li>
            <a class="reportium-nav-link{{#active}} is-active{{/active}}" href="{{{url}}}"{{#active}} aria-current="page"{{/active}}>
                <i class="fa {{icon}}" aria-hidden="true"></i> {{label}}
            </a>
        </li>
        {{/items}}
    </ul>
    {{#allreports}}
    <a class="reportium-nav-link reportium-nav-all{{#active}} is-active{{/active}}" href="{{{url}}}"{{#active}} aria-current="page"{{/active}}>
        <i class="fa fa-list" aria-hidden="true"></i> {{label}}
    </a>
    {{/allreports}}
</nav>
