{{!
    @template local_reportium/levels

    Shell of the interactive report (generic levels). The module local_reportium/levels fills every region.

    Context variables required for this template:
    * rootid - id of the root element
    * config - JSON configuration read by the module (report id, states, formats, chat strings...)

    Example context (json):
    {
        "rootid": "reportium-app-1",
        "config": "{\"reportid\": 1, \"courseid\": 1}"
    }
}}
<div id="{{rootid}}" class="reportium-app is-loading" data-region="reportium-app" data-config="{{config}}">
    <div class="reportium-header">
        <nav class="reportium-breadcrumbs" data-region="breadcrumbs" aria-label="{{#str}}breadcrumb, access{{/str}}"></nav>
        <h3 class="reportium-title" data-region="title"></h3>
    </div>
    {{! Controls are not printed: Print report shows title, level, charts, tables and totals only. }}
    <div class="reportium-toolbar d-print-none" data-region="toolbar"></div>
    <div class="d-print-none" data-region="filters"></div>
    <div class="d-print-none" data-region="settings"></div>
    <div class="d-print-none" data-region="sql"></div>
    {{! Side tabs on the right edge: Filters, Chart settings, SQL. }}
    <div class="d-print-none" data-region="sidetabs"></div>
    <div class="reportium-body" data-region="body">
        <div class="reportium-loading">{{#pix}}i/loading, core{{/pix}}</div>
    </div>
</div>
