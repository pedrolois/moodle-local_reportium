{{!
    @template local_reportium/kpi_popover

    Popover to add, change or remove a KPI card: its column and its calculation. Rendered from JavaScript
    (local_reportium/levels); its events are handled on the report root.

    Context variables required for this template:
    * title - Title of the popover
    * columnlabel - Label of the column select
    * columns - [{value, label, selected}]
    * calculationlabel - Label of the calculation select
    * aggs - [{value, label, selected}]
    * duplicate - Error shown when the card already exists
    * apply - Label of the apply button
    * save - false, or the label of the save button
    * remove - false, or the label of the remove button

    Example context (json):
    {
        "title": "Edit card",
        "columnlabel": "Column",
        "columns": [{"value": "_rows", "label": "Rows", "selected": false}, {"value": "n", "label": "N", "selected": true}],
        "calculationlabel": "Calculation",
        "aggs": [{"value": "sum", "label": "Sum", "selected": true}],
        "duplicate": "This card is already shown.",
        "apply": "Apply",
        "save": "Save",
        "remove": "Remove"
    }
}}
<div class="reportium-col-filter reportium-kpi-popover" data-region="kpi-popover" role="dialog" aria-label="{{title}}">
    <div class="reportium-col-filter-title"><i class="fa fa-gear fa-cog" aria-hidden="true"></i> {{title}}</div>
    <div class="reportium-col-filter-body">
        <label>{{columnlabel}}
            <select class="form-control form-control-sm" data-kpi-field="key">
                {{#columns}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/columns}}
            </select></label>
        <label data-region="kpi-agg-field">{{calculationlabel}}
            <select class="form-control form-control-sm" data-kpi-field="agg">
                {{#aggs}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/aggs}}
            </select></label>
        <div class="text-danger small" data-region="kpi-error" hidden>{{duplicate}}</div>
        <div class="reportium-kpi-popover-actions">
            <button type="button" class="btn btn-sm btn-primary" data-action="kpi-apply">{{apply}}</button>
            {{#save}}<button type="button" class="btn btn-sm btn-outline-primary" data-action="kpi-save">{{save}}</button>{{/save}}
            {{#remove}}
            <button type="button" class="btn btn-sm btn-link text-danger" data-action="kpi-remove">{{remove}}</button>
            {{/remove}}
        </div>
    </div>
</div>
